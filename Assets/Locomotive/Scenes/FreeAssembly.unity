  m_Name: 
  m_EditorClassIdentifier: 
  engine: {fileID: 303209367}
  effects: {fileID: 303209369}
  modules:
  - title: "\u9505\u7089\u4E0E\u706B\u7BB1"
    action: "\u5C06\u9505\u7089\u7EC4\u4EF6\u653E\u5230\u8F66\u67B6\u4E0A\u65B9\u3002"
    meaning: "\u8BA9\u70ED\u91CF\u6709\u4E00\u4E2A\u8D77\u70B9\u3002\n\u7164\u5728\u706B\u7BB1\u4E2D\u71C3\u70E7\uFF0C\u9AD8\u6E29\u70DF\u6C14\u7A7F\u8FC7\u70DF\u7BA1\uFF0C\u52A0\u70ED\u7BA1\u5916\u7684\u6C34\u3002"
    feedback: "\u706B\u7BB1\u5185\u71C3\u7164\u53D1\u70ED\u3002\n\u6A59\u7EA2\u7BAD\u5934\u6CBF\u70DF\u7BA1\u524D\u8FDB\uFF1B\u84DD\u8272\u533A\u57DF\u662F\u7BA1\u5916\u7684\u6C34\u3002\u6C34\u53D7\u70ED\u4EA7\u751F\u84B8\u6C7D\u3002"
    prefab: {fileID: 1557822200147004495, guid: c6755b44ba718554785a9928957a63d5,
      type: 3}
    centre: {x: 0.26849997, y: 2.3849998, z: 0}
    previewScale: 0.477669
  - title: "\u6C7D\u7F38\u4E0E\u6D3B\u585E"
    action: "\u5C06\u6C7D\u7F38\u7EC4\u4EF6\u653E\u5230\u8F66\u67B6\u524D\u7AEF\u3002"
    meaning: "\u8BA9\u84B8\u6C7D\u6709\u4E00\u4E2A\u505A\u529F\u7684\u5730\u65B9\u3002\n\u6D3B\u585E\u628A\u6C7D\u7F38\u5206\u6210\u4E24\u7AEF\uFF0C\u84B8\u6C7D\u8FDB\u5165\u4E00\u7AEF\u5C31\u63A8\u52A8\u6D3B\u585E\u3002"
    feedback: "\u6D3B\u585E\u5DF2\u7ECF\u5C31\u4F4D\u3002\n\u89C2\u5BDF\u6C7D\u7F38\u5185\u7684\u6D3B\u585E\uFF0C\u4EE5\u53CA\u7A7F\u8FC7\u540E\u76D6\u7684\u6D3B\u585E\u6746\uFF1B\u5B83\u4EEC\u53EA\u80FD\u6CBF\u540C\u4E00\u8F74\u7EBF\u5F80\u590D\u3002"
    prefab: {fileID: 9005724623795567309, guid: 7c405c5db76f2cf45b688751bb2e2918,
      type: 3}
    centre: {x: 2.8793192, y: 0.6463101, z: -0.00000011920929}
    previewScale: 0.7055784
  - title: "\u4E3B\u8FDE\u6746\u4F20\u52A8"
    action: "\u5C06\u8FDE\u6746\u7EC4\u4EF6\u8FDE\u63A5\u5230\u52A8\u8F6E\u4E0E\u6D3B\u585E\u4E4B\u95F4\u3002"
    meaning: "\u628A\u5F80\u590D\u8FD0\u52A8\u53D8\u6210\u8F6C\u52A8\u3002\n\u5341\u5B57\u5934\u6CBF\u5BFC\u8F68\u6ED1\u52A8\uFF0C\u4E3B\u8FDE\u6746\u628A\u63A8\u529B\u4F20\u5230\u52A8\u8F6E\u7684\u66F2\u67C4\u9500\u3002"
    feedback: "\u4F20\u52A8\u94FE\u5DF2\u7ECF\u8FDE\u901A\u3002\n\u6162\u901F\u6F14\u793A\u4E2D\uFF0C\u6D3B\u585E\u6746\u3001\u5341\u5B57\u5934\u4E0E\u4E3B\u8FDE\u6746\u5171\u540C\u9A71\u52A8\u52A8\u8F6E\uFF1B\u8054\u52A8\u6746\u4FDD\u6301\u4E09\u4E2A\u8F6E\u5BF9\u540C\u6B65\u3002"
    prefab: {fileID: 6151903098613887493, guid: 779a00d27e0b5e148a18251e9f131b54,
      type: 3}
    centre: {x: 1.25286, y: 0.74672824, z: 0}
    previewScale: 0.6640106
  - title: "\u914D\u6C7D\u4E0E\u6362\u5411"
    action: "\u5C06\u914D\u6C7D\u7EC4\u4EF6\u5B89\u88C5\u5728\u4E3B\u8FDE\u6746\u5916\u4FA7\u3002"
    meaning: "\u51B3\u5B9A\u4F55\u65F6\u8FDB\u6C7D\u3001\u4F55\u65F6\u6392\u6C7D\u3002\n\u8F6E\u7EC4\u5E26\u52A8\u914D\u6C7D\u8FDE\u6746\uFF0C\u6ED1\u9600\u4EA4\u66FF\u6253\u5F00\u6C7D\u7F38\u4E24\u7AEF\u7684\u901A\u9053\u3002"
    feedback: "\u6ED1\u9600\u8DDF\u968F\u52A8\u8F6E\u5F80\u590D\u3002\n\u6CE8\u610F\u5B83\u4EA4\u66FF\u8986\u76D6\u548C\u6253\u5F00\u6C14\u53E3\uFF1A\u8FDB\u6C7D\u7684\u4E00\u4FA7\u505A\u529F\uFF0C\u53E6\u4E00\u4FA7\u6392\u6C7D\u3002\u6362\u5411\u673A\u6784\u6539\u53D8\u65F6\u5E8F\u3002"
    prefab: {fileID: 6963163510816617861, guid: bf5e2a8c928b0ca4b9258e8b13526834,
      type: 3}
    centre: {x: 0.80014277, y: 1.0046864, z: 0.00000011920929}
    previewScale: 0.36766636
  - title: "\u8FDB\u6C7D\u7BA1\u8DEF"
    action: "\u8FDE\u63A5\u6C7D\u5305\u3001\u8C03\u8282\u9600\u548C\u6C7D\u5BA4\u3002"
    meaning: "\u628A\u9505\u7089\u548C\u6C7D\u7F38\u8FDE\u901A\u3002\n\u84B8\u6C7D\u4ECE\u6C7D\u5305\u7ECF\u8FC7\u8C03\u8282\u9600\uFF0C\u8FDB\u5165\u5DE6\u53F3\u6C7D\u5BA4\uFF0C\u7B49\u5F85\u6ED1\u9600\u5206\u914D\u3002"
    feedback: "\u91D1\u8272\u7BAD\u5934\u8868\u793A\u65B0\u9C9C\u84B8\u6C7D\u3002\n\u84B8\u6C7D\u7ECF\u6C7D\u5305\u548C\u8C03\u8282\u9600\u8FDB\u5165\u6C7D\u5BA4\uFF0C\u53EA\u80FD\u901A\u8FC7\u5F53\u524D\u6253\u5F00\u7684\u6C14\u53E3\u8FDB\u5165\u6C7D\u7F38\u3002"
    prefab: {fileID: 6024985865230330810, guid: 4f85dda40cdecb441b8bf5e12a153a3f,
      type: 3}
    centre: {x: 0.63750005, y: 2.045, z: 0}
    previewScale: 0.4381161
  - title: "\u6392\u6C7D\u4E0E\u70DF\u56F1"
    action: "\u628A\u70DF\u7BB1\u548C\u70DF\u56F1\u88C5\u5230\u9505\u7089\u524D\u7AEF\u3002"
    meaning: "\u8BA9\u505A\u529F\u540E\u7684\u84B8\u6C7D\u79BB\u5F00\u3002\n\u6392\u6C7D\u6C47\u5165\u70DF\u7BB1\u55B7\u7BA1\uFF0C\u5411\u70DF\u56F1\u55B7\u51FA\uFF0C\u5E76\u5E2E\u52A9\u62BD\u8D70\u71C3\u70E7\u70DF\u6C14\u3002"
    feedback: "\u9752\u8272\u7BAD\u5934\u8868\u793A\u505A\u529F\u540E\u7684\u6392\u6C7D\u3002\n\u6392\u6C7D\u4E0E\u70DF\u7BA1\u4E2D\u7684\u71C3\u70E7\u70DF\u6C14\u5728\u70DF\u7BB1\u76F8\u9047\uFF0C\u7531\u70DF\u56F1\u6392\u51FA\uFF1B\u4E8C\u8005\u5728\u9505\u7089\u5185\u8D70\u4E0D\u540C\u901A\u9053\u3002"
    prefab: {fileID: 3975117912347976599, guid: 7caf17d0aa447c2448bb04ba9a245821,
      type: 3}
    centre: {x: 2.7735002, y: 2.2615001, z: 0}
